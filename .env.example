UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# paper: no private API call, no real order
# test: calls /v1/orders/test, no real order but requires order permission
# live: calls /v1/orders and can spend real money
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
CONFIRM_LIVE_MARKET=KRW-BTC

UPBIT_BASE_URL=https://api.upbit.com
MARKET=KRW-BTC
CANDLE_UNIT=5
CANDLE_COUNT=60
SHORT_SMA=5
LONG_SMA=20

# Keep this small while proving the system.
ORDER_KRW=5000
MIN_KRW_BALANCE=10000
SELL_RATIO=1.0

STATE_FILE=state/trader_state.json
